# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# v2.0: pretrained YOLO weights — download once on first use (ultralytics
# caches its own copy too), never committed as a repo binary.
*.pt
yolo11*.pt
runs/

# Node / frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# Data (never commit large datasets/recordings)
data/raw/*
data/processed/*
data/annotations/*
data/models/*
data/recordings/*
data/reports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/annotations/.gitkeep
!data/models/.gitkeep
!data/recordings/.gitkeep
!data/reports/.gitkeep

# Env / secrets
.env
*.local

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
