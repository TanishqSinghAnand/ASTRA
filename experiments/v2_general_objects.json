{
  "experiment_id": "V2_GENERAL_OBJECTS_001",
  "name": "General Object Placement Demo (v2.0)",
  "description": "Pick up a blue box and a yellow box (HSV color detection, same approach as v1.0) and place each in its own designated zone — demonstrates per-object target locations.",
  "objects": {
    "BLUE_BOX": { "label": "blue box", "color_hint": "blue" },
    "YELLOW_BOX": { "label": "yellow box", "color_hint": "yellow" },
    "ZONE_A": { "label": "zone A", "color_hint": null },
    "ZONE_B": { "label": "zone B", "color_hint": null }
  },
  "steps": [
    {
      "id": 1,
      "action": "PICK",
      "object": "BLUE_BOX",
      "instruction": "Pick up the blue box.",
      "voice_next": "Next, place the blue box in zone A."
    },
    {
      "id": 2,
      "action": "PLACE",
      "object": "BLUE_BOX",
      "target": "ZONE_A",
      "instruction": "Place the blue box in zone A.",
      "voice_next": "Next, pick up the yellow box."
    },
    {
      "id": 3,
      "action": "PICK",
      "object": "YELLOW_BOX",
      "instruction": "Pick up the yellow box.",
      "voice_next": "Next, place the yellow box in zone B."
    },
    {
      "id": 4,
      "action": "PLACE",
      "object": "YELLOW_BOX",
      "target": "ZONE_B",
      "instruction": "Place the yellow box in zone B.",
      "voice_next": "Experiment completed successfully."
    },
    {
      "id": 5,
      "action": "COMPLETE",
      "object": "EXPERIMENT",
      "instruction": "Close out the experiment.",
      "voice_next": "Experiment completed successfully."
    }
  ]
}
