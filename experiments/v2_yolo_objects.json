      "action": "PLACE",
      "object": "BOTTLE",
      "target": "ZONE_B",
      "instruction": "Place the bottle in zone B.",
      "voice_next": "Experiment completed successfully."
    },
    {
      "id": 5,
      "action": "COMPLETE",
      "object": "EXPERIMENT",
